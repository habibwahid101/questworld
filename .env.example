# Questra World public configuration.
# These names are not secrets. Do not put AWS access keys or passwords here.
# Leave the Cognito IDs blank to use the deployed public values in lib/auth/config.ts.
# Set them only to override that configuration locally.
# Do not commit .env, .env.local, or .env.production.
# Amplify Hosting is expected to supply NEXT_PUBLIC_* at build time.

NEXT_PUBLIC_APP_NAME=Questra World
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Public execute-api URL for QuestworldApi. Not a secret. Leave blank until that stack is deployed.
NEXT_PUBLIC_MEMBER_API_URL=
