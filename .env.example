# Questra World public configuration.
# These Cognito identifiers are not secrets. Do not put AWS access keys here.
# Fill the pool and client IDs from `cdk deploy` outputs. Leave them empty until then.

NEXT_PUBLIC_APP_NAME=Questra World
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
